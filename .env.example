NOVEL_TRANSLATOR_BASE_URL=https://seu-endpoint/v1
NOVEL_TRANSLATOR_MODEL=seu-modelo
NOVEL_TRANSLATOR_API_KEY=cole-sua-chave-aqui

# Interface web (opcionais)
# NOVEL_TRANSLATOR_CATALOG=novels.yaml
# NOVEL_TRANSLATOR_WORKSPACE=.novel-translator
# NOVEL_TRANSLATOR_DATABASE=sqlite:///.novel-translator/working-copies.sqlite
# NOVEL_TRANSLATOR_WEB_HOST=127.0.0.1
# NOVEL_TRANSLATOR_SITE_ROOT=../novels-site

# Sala web: sem essas duas variáveis ela abre sem login (só dev local).
# Gere com novel_translator.web.auth.hash_password e secrets.token_hex(32).
# NOVEL_TRANSLATOR_PROVIDER=opencode-go
# NOVEL_TRANSLATOR_REQUEST_TIMEOUT=300.0
# NOVEL_TRANSLATOR_POLL_SECONDS=5.0
# NOVEL_TRANSLATOR_HEARTBEAT_SECONDS=30.0
# NOVEL_TRANSLATOR_STALE_SECONDS=120.0
